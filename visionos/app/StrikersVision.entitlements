<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No com.apple.developer.group-session: a free-account provisioning profile cannot carry it,
	     and an app signed with an entitlement its profile lacks is killed at launch. SharePlay then
	     stays off (SVEntitlements.hasGroupSession) and room codes still work. -->
	<!-- The game keeps the whole GameCube memory map, the disc cache and Dawn's pipelines resident. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
